{
  "name": "dcl-project",
  "version": "1.0.0",
  "description": "Endless Vortex \u2014 vortex gliding, airtime standings and temporary landing platforms",
  "scripts": {
    "start": "sdk-commands start",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.cjs",
    "server": "node server/index.js",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next",
    "tutorial:assets": "node scripts/generate-tutorial-assets.cjs",
    "tutorial:preview": "node scripts/preview-tutorial.cjs",
    "rank:assets": "node scripts/generate-rank-insignia.cjs"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.30.1",
    "@dcl/sdk": "7.30.1",
    "@resvg/resvg-js": "^2.6.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}
