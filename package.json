{
  "name": "dcl-project",
  "version": "1.0.0",
  "description": "Endless Vortex — vortex gliding, airtime standings and temporary landing platforms",
  "scripts": {
    "start": "sdk-commands start",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.cjs",
    "server": "node server/index.js",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.29.0",
    "@dcl/sdk": "7.29.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}